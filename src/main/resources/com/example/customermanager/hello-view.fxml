<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.example.customermanager.HelloController"
      spacing="10.0"
      alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Input Controls Row -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Name:"/>
        <TextField fx:id="nameField" promptText="Name..." prefWidth="130.0"/>

        <Label text="Province:"/>
        <ComboBox fx:id="provinceComboBox" promptText="Select Province..." prefWidth="130.0"/>

        <Button text="Add Customer" onAction="#handleAddCustomer"/>
        <Button text="Delete Selected" onAction="#handleDeleteCustomer"/>
    </HBox>

    <!-- Validation / Error Message Label -->
    <Label fx:id="statusLabel" textFill="RED"/>

    <!-- Table Section -->
    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Customer Name" prefWidth="200.0"/>
            <TableColumn fx:id="provinceColumn" text="Province" prefWidth="200.0"/>
        </columns>
    </TableView>
</VBox>